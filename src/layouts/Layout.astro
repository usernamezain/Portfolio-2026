---
import SEO from '../components/seo/SEO.astro';
import CursorBuildLoader from '../components/motion/CursorBuildLoader.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogImage?: string;
  isHome?: boolean;
  type?: 'website' | 'profile' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  articleSection?: string;
  structuredData?: Record<string, any>;
}

const { isHome: explicitIsHome, ...props } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = explicitIsHome !== undefined ? explicitIsHome : currentPath === '/';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    
    <!-- Theme script executed synchronously before first paint to prevent theme flash (FOUC) -->
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- SEO Meta Suite & JSON-LD Structured Data Graph -->
    <SEO {...props} />

    <!-- Favicon & Touch Icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Accessibility Skip Link -->
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Reading Progress Bar (ScaleX driven by GSAP) -->
    <div class="progress-bar" aria-hidden="true"></div>

    <!-- CursorBuild Loading Ceremony (Multiplayer Cursors Drawing on Page Load) - Only on Home Page -->
    {isHomePage && <CursorBuildLoader />}

    <!-- Navigation Header -->
    <Header />

    <!-- Main Content Slot -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- High-Performance Motion Controller (GSAP + Lenis + Anime.js) -->
    <script>
      import { initMotionSystem, initThemeToggle } from '../scripts/animationController';
      import MascotCrew from '../scripts/mascot-crew';

      // Setup theme toggle interactions
      initThemeToggle();

      // Launch unified motion architecture
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initMotionSystem();
        });
      } else {
        initMotionSystem();
      }

      // Launch Pixel Mascot Crew strictly on the Home page, contained in their respective sections
      function launchMascotCrew() {
        if (!MascotCrew) return;
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const isHomePage = currentPath === '/' || currentPath.endsWith('/index.html');
        if (!isHomePage) {
          if (MascotCrew.destroy) MascotCrew.destroy();
          document.querySelectorAll('.pg.mk').forEach((el) => el.remove());
          return;
        }

        let launched = false;
        const start = () => {
          if (launched) return;
          launched = true;
          MascotCrew.start({
            assignments: [
              { mascot: 'ghost', container: '#about' },
              { mascot: 'gemini', container: '#stack' },
              { mascot: 'chatgpt', container: '#projects' },
              { mascot: 'github', container: '#faq' }
            ],
            textInteraction: false,
            size: 20
          });
        };

        const hasLoader = !!document.getElementById('cb-loader-root');
        if (hasLoader) {
          window.addEventListener('cb:dismissed', start, { once: true });
          setTimeout(start, 7000);
        } else {
          start();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', launchMascotCrew);
      } else {
        launchMascotCrew();
      }

      document.addEventListener('astro:page-load', launchMascotCrew);
      document.addEventListener('astro:before-swap', () => {
        if (MascotCrew) MascotCrew.destroy();
        document.querySelectorAll('.pg.mk').forEach((el) => el.remove());
      });
    </script>
  </body>
</html>
