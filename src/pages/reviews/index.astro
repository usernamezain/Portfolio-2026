---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/common/Icon.astro';
import { reviewsData } from '../../data/reviews';

const pageTitle = "What Clients Said | Zain Ali Developer (zainalidev)";
const pageDesc = "Interactive 2D physics testimonial wall featuring real client reviews, recommendations, and feedback for Zain Ali Developer. Grab, drag, toss, or click any review card.";
const canonicalUrl = "https://zaindev.me/reviews";
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  type="website"
>
  <div class="reviews-page">
    <!-- Full Interactive Physics Stage -->
    <section class="physics-stage" id="physics-stage" aria-label="Interactive Physics Review Stage">
      <!-- Centered Background Typography (Clean, No Capsule Pill) -->
      <div class="stage-center-headline" aria-hidden="true">
        <h1 class="headline-title">What clients said.</h1>
        <p class="headline-subtitle">
          Real feedback from founders, clients &amp; engineers. Drag, toss, or click any card.
        </p>
      </div>

      <!-- Live Falling Physics Cards (DOM Elements synced to Matter.js bodies) -->
      <div class="cards-layer" id="cards-layer">
        {reviewsData.map((review) => (
          <article
            class="physics-card"
            data-review-id={review.id}
            tabindex="0"
            role="button"
            aria-haspopup="dialog"
            aria-label={`Review by ${review.name}. Click to view full review.`}
          >
            <div class="card-inner">
              <div class="card-header">
                <img
                  src={review.avatarImage}
                  alt={review.name}
                  class="client-avatar"
                  loading="lazy"
                  width="38"
                  height="38"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="avatar-fallback" style="display: none;">
                  {review.avatarFallback}
                </div>

                <div class="client-meta">
                  <div class="client-name">{review.name}</div>
                  <div class="client-stars" aria-label={`${review.rating} out of 5 stars`}>
                    {"★".repeat(review.rating)}{"☆".repeat(5 - review.rating)}
                  </div>
                </div>
              </div>

              <!-- Paragraph what they wrote -->
              <p class="card-text">{review.highlight}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Floating Controls Dock [Toss Cards | Drop Again] -->
      <div class="bottom-dock-wrapper">
        <div class="bottom-dock">
          <button type="button" id="btn-toss" class="dock-btn" aria-label="Toss cards in the air">
            <Icon name="zap" size={14} />
            <span>Toss Cards</span>
          </button>
          <div class="dock-divider" aria-hidden="true"></div>
          <button type="button" id="btn-drop" class="dock-btn" aria-label="Drop cards from the top again">
            <Icon name="rotate-ccw" size={14} />
            <span>Drop Again</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Accessible Static List for Screen Readers & Fallback -->
    <section class="sr-only" aria-label="Accessible Client Reviews">
      <h2>All Verified Client Reviews</h2>
      <ul>
        {reviewsData.map((review) => (
          <li>
            <h3>{review.name} ({review.role} at {review.company}) - {review.rating}/5 Stars</h3>
            <p>{review.content}</p>
            <p>Delivered Project: {review.project}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Clean Redesigned Modal Dialog -->
    <div id="review-modal-backdrop" class="modal-backdrop" aria-hidden="true" hidden>
      <div
        id="review-modal"
        class="modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-client-name"
      >
        <button type="button" id="modal-close-btn" class="modal-close" aria-label="Close review dialog">
          <Icon name="x" size={17} />
        </button>

        <!-- Top Profile Info -->
        <div class="modal-top">
          <img
            id="modal-avatar-img"
            src=""
            alt=""
            class="modal-avatar"
            width="50"
            height="50"
          />
          <div class="modal-meta">
            <h2 id="modal-client-name" class="modal-name"></h2>
            <div id="modal-client-role" class="modal-sub"></div>
            <div class="modal-stars" id="modal-stars"></div>
          </div>
        </div>

        <!-- Full Review Testimonial Text -->
        <div class="modal-body">
          <p id="modal-content" class="modal-paragraph"></p>
        </div>

        <!-- Clean Project Footer -->
        <div class="modal-project-bar">
          <div class="project-info">
            <span class="project-caption mono">DELIVERED PROJECT</span>
            <span id="modal-project-title" class="project-title"></span>
          </div>
          <a
            id="modal-project-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="project-link-btn"
          >
            <span>View Project</span>
            <Icon name="external-link" size={13} />
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Matter from 'matter-js';
  import { reviewsData } from '../../data/reviews';

  const {
    Engine,
    Bodies,
    Composite,
    Mouse,
    MouseConstraint,
    Events,
    Body
  } = Matter;

  function initReviewsPhysics() {
    const stage = document.getElementById('physics-stage');
    const cardsLayer = document.getElementById('cards-layer');
    if (!stage || !cardsLayer) return;

    // Destroy existing instance if any
    if ((window as any).__reviewsEngine) {
      Matter.Engine.clear((window as any).__reviewsEngine);
      if ((window as any).__reviewsRunner) {
        cancelAnimationFrame((window as any).__reviewsRunner);
      }
    }

    const cardElements = Array.from(cardsLayer.querySelectorAll<HTMLElement>('.physics-card'));
    if (!cardElements.length) return;

    // Dimensions
    let width = stage.clientWidth;
    let height = stage.clientHeight;

    // Setup Engine with gravity
    const engine = Engine.create({
      gravity: { x: 0, y: 0.95 }
    });
    (window as any).__reviewsEngine = engine;
    const world = engine.world;

    // Boundaries: Left, Right, Bottom (TOP IS INFINITE, NO CEILING)
    const wallThickness = 120;
    
    // Bottom floor
    let ground = Bodies.rectangle(width / 2, height + wallThickness / 2, width * 2, wallThickness, {
      isStatic: true,
      friction: 0.45,
      restitution: 0.22
    });

    // Left wall
    let leftWall = Bodies.rectangle(-wallThickness / 2, height / 2, wallThickness, height * 4, {
      isStatic: true,
      friction: 0.1,
      restitution: 0.3
    });

    // Right wall
    let rightWall = Bodies.rectangle(width + wallThickness / 2, height / 2, wallThickness, height * 4, {
      isStatic: true,
      friction: 0.1,
      restitution: 0.3
    });

    Composite.add(world, [ground, leftWall, rightWall]);

    // Map DOM elements to Matter.js bodies
    const cardBodyMap = new Map<HTMLElement, Matter.Body>();

    // Spawn Cards falling from above the stage (staggered cascade)
    cardElements.forEach((cardEl, index) => {
      cardEl.style.opacity = '1';
      
      const cardW = cardEl.offsetWidth || (window.innerWidth < 640 ? 240 : 285);
      const cardH = cardEl.offsetHeight || (window.innerWidth < 640 ? 115 : 135);

      // Random starting X distributed across stage width (guarded for mobile)
      const pad = cardW / 2 + 10;
      const minX = pad;
      const maxX = Math.max(pad, width - pad);
      const startX = minX < maxX ? minX + Math.random() * (maxX - minX) : width / 2;

      // Staggered starting height ABOVE the viewport (infinite top)
      const startY = -90 - (index * 125);
      const startAngle = (Math.random() - 0.5) * (width < 640 ? 0.25 : 0.4);

      const body = Bodies.rectangle(startX, startY, cardW, cardH, {
        chamfer: { radius: 12 },
        restitution: 0.28,
        friction: 0.25,
        frictionAir: 0.018,
        density: 0.002,
        angle: startAngle
      });

      cardBodyMap.set(cardEl, body);
      Composite.add(world, body);
    });

    // Mouse & Touch Drag-and-Drop Constraint
    const mouse = Mouse.create(stage);
    if (mouse.element) {
      mouse.element.removeEventListener('mousewheel', (mouse as any).mousewheel);
      mouse.element.removeEventListener('DOMMouseScroll', (mouse as any).mousewheel);
    }

    const mouseConstraint = MouseConstraint.create(engine, {
      mouse: mouse,
      constraint: {
        stiffness: 0.25,
        render: { visible: false }
      }
    });

    Composite.add(world, mouseConstraint);

    // Track active drag state for cursor
    Events.on(mouseConstraint, 'startdrag', () => {
      stage.classList.add('is-dragging');
    });

    Events.on(mouseConstraint, 'enddrag', () => {
      stage.classList.remove('is-dragging');
    });

    // Animation Runner Loop
    let animId: number;
    let lastTime = performance.now();

    function runnerLoop(time: number) {
      const dt = Math.min(time - lastTime, 32);
      lastTime = time;
      Engine.update(engine, dt);

      // Sync DOM transforms with Matter.js physics coordinates
      cardElements.forEach((cardEl) => {
        const body = cardBodyMap.get(cardEl);
        if (!body) return;

        // Boundary sanity check (keep in bounds if thrown wildly)
        if (body.position.y > height + 300) {
          Body.setPosition(body, { x: width / 2, y: -80 });
          Body.setVelocity(body, { x: 0, y: 0 });
        }
        if (body.position.x < -200) {
          Body.setPosition(body, { x: 100, y: body.position.y });
          Body.setVelocity(body, { x: 2, y: 0 });
        }
        if (body.position.x > width + 200) {
          Body.setPosition(body, { x: width - 100, y: body.position.y });
          Body.setVelocity(body, { x: -2, y: 0 });
        }

        const x = body.position.x - cardEl.offsetWidth / 2;
        const y = body.position.y - cardEl.offsetHeight / 2;
        const deg = (body.angle * 180) / Math.PI;

        cardEl.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) rotate(${deg.toFixed(2)}deg)`;
      });

      animId = requestAnimationFrame(runnerLoop);
      (window as any).__reviewsRunner = animId;
    }

    animId = requestAnimationFrame(runnerLoop);
    (window as any).__reviewsRunner = animId;

    // Responsive Window Resize & Orientation Handling
    let resizeTimer: any;
    function handleResize() {
      if (!stage) return;
      width = stage.clientWidth;
      height = stage.clientHeight;

      Body.setPosition(ground, { x: width / 2, y: height + wallThickness / 2 });
      Body.setPosition(leftWall, { x: -wallThickness / 2, y: height / 2 });
      Body.setPosition(rightWall, { x: width + wallThickness / 2, y: height / 2 });

      // Clamp all card bodies within updated boundaries
      cardElements.forEach((cardEl) => {
        const body = cardBodyMap.get(cardEl);
        if (!body) return;
        const halfW = cardEl.offsetWidth / 2;
        const halfH = cardEl.offsetHeight / 2;
        const clampedX = Math.max(halfW + 6, Math.min(width - halfW - 6, body.position.x));
        const clampedY = Math.min(height - halfH - 2, body.position.y);
        Body.setPosition(body, { x: clampedX, y: clampedY });
      });
    }

    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(handleResize, 100);
    });
    window.addEventListener('orientationchange', () => {
      setTimeout(handleResize, 200);
    });

    // Toss Cards Button in Bottom Dock
    const tossBtn = document.getElementById('btn-toss');
    if (tossBtn) {
      tossBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        cardElements.forEach((cardEl) => {
          const body = cardBodyMap.get(cardEl);
          if (!body) return;
          const upVelocity = -12 - Math.random() * 8;
          const sideVelocity = (Math.random() - 0.5) * 14;
          const torque = (Math.random() - 0.5) * 0.18;
          Body.setVelocity(body, { x: sideVelocity, y: upVelocity });
          Body.setAngularVelocity(body, torque);
        });
      });
    }

    // Drop Again Button in Bottom Dock
    const dropBtn = document.getElementById('btn-drop');
    if (dropBtn) {
      dropBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        cardElements.forEach((cardEl, index) => {
          const body = cardBodyMap.get(cardEl);
          if (!body) return;
          const pad = cardEl.offsetWidth / 2 + 20;
          const minX = Math.min(pad, width / 2);
          const maxX = Math.max(width - pad, width / 2);
          const startX = minX + Math.random() * (maxX - minX);
          const startY = -100 - (index * 130);
          Body.setPosition(body, { x: startX, y: startY });
          Body.setVelocity(body, { x: 0, y: 1 });
          Body.setAngularVelocity(body, (Math.random() - 0.5) * 0.2);
        });
      });
    }

    // Drag vs Click Detection
    cardElements.forEach((cardEl) => {
      let pointerDownPos = { x: 0, y: 0 };
      let dragged = false;

      cardEl.addEventListener('pointerdown', (e) => {
        pointerDownPos = { x: e.clientX, y: e.clientY };
        dragged = false;
      });

      cardEl.addEventListener('pointermove', (e) => {
        const dx = e.clientX - pointerDownPos.x;
        const dy = e.clientY - pointerDownPos.y;
        if (Math.hypot(dx, dy) > 7) {
          dragged = true;
        }
      });

      cardEl.addEventListener('click', (e) => {
        if (dragged) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        const reviewId = cardEl.getAttribute('data-review-id');
        if (reviewId) {
          openReviewModal(reviewId);
        }
      });

      cardEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const reviewId = cardEl.getAttribute('data-review-id');
          if (reviewId) openReviewModal(reviewId);
        }
      });
    });
  }

  // Redesigned Modal Handlers
  const backdrop = document.getElementById('review-modal-backdrop');
  const closeBtn = document.getElementById('modal-close-btn');

  function openReviewModal(reviewId: string) {
    const review = reviewsData.find((r) => r.id === reviewId);
    if (!review || !backdrop) return;

    const modalAvatar = document.getElementById('modal-avatar-img') as HTMLImageElement | null;
    const modalName = document.getElementById('modal-client-name');
    const modalRole = document.getElementById('modal-client-role');
    const modalStars = document.getElementById('modal-stars');
    const modalContent = document.getElementById('modal-content');
    const modalProject = document.getElementById('modal-project-title');
    const modalLink = document.getElementById('modal-project-link') as HTMLAnchorElement | null;

    if (modalAvatar) {
      modalAvatar.src = review.avatarImage;
      modalAvatar.alt = review.name;
    }
    if (modalName) modalName.textContent = review.name;
    if (modalRole) modalRole.textContent = `${review.role} • ${review.company}`;
    if (modalStars) modalStars.textContent = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);
    if (modalContent) modalContent.textContent = review.content;
    if (modalProject) modalProject.textContent = review.project;

    if (modalLink) {
      if (review.projectUrl) {
        modalLink.href = review.projectUrl;
        modalLink.style.display = 'inline-flex';
      } else {
        modalLink.style.display = 'none';
      }
    }

    backdrop.removeAttribute('hidden');
    backdrop.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeReviewModal() {
    if (!backdrop) return;
    backdrop.classList.remove('is-open');
    setTimeout(() => {
      backdrop.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }, 200);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeReviewModal);
  }

  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeReviewModal();
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && backdrop && !backdrop.hasAttribute('hidden')) {
      closeReviewModal();
    }
  });

  // Launch on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewsPhysics);
  } else {
    initReviewsPhysics();
  }
</script>

<style>
  .reviews-page {
    position: relative;
    width: 100%;
    min-height: calc(100vh - var(--nav-h));
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow: hidden;
  }

  /* Physics Stage */
  .physics-stage {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--nav-h));
    height: calc(100dvh - var(--nav-h));
    min-height: 480px;
    overflow: hidden;
    touch-action: none;
    cursor: default;
  }

  .physics-stage.is-dragging {
    cursor: grabbing !important;
  }

  /* Centered Background Hero Typography */
  .stage-center-headline {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 820px;
    text-align: center;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  .headline-title {
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--t1);
    margin: 0 0 var(--s3);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  .headline-subtitle {
    font-size: clamp(14px, 1.8vw, 17px);
    color: var(--t3);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Cards Layer & Physics Card Styling */
  .cards-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  .physics-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 290px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
    cursor: grab;
    pointer-events: auto;
    user-select: none;
    transform-origin: center center;
    will-change: transform;
    opacity: 0;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .physics-card:active {
    cursor: grabbing;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.38);
    border-color: var(--accent);
  }

  .physics-card:hover {
    border-color: var(--border-focus);
  }

  .card-inner {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .client-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  .avatar-fallback {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .client-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .client-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--t1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .client-stars {
    font-size: 12px;
    color: #f59e0b;
    letter-spacing: 2px;
    line-height: 1;
  }

  .card-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--t2);
    margin: 0;
    font-weight: 450;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Bottom Controls Dock [Toss Cards | Drop Again] */
  .bottom-dock-wrapper {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 25;
    pointer-events: auto;
  }

  .bottom-dock {
    display: inline-flex;
    align-items: center;
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--r-full);
    padding: 5px 8px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    gap: 4px;
  }

  [data-theme='light'] .bottom-dock {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .dock-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    background: transparent;
    border: none;
    border-radius: var(--r-full);
    color: var(--t1);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .dock-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent);
  }

  [data-theme='light'] .dock-btn:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .dock-divider {
    width: 1px;
    height: 18px;
    background: var(--border);
  }

  /* Redesigned Clean Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-dialog {
    position: relative;
    width: 100%;
    max-width: 520px;
    background: var(--card);
    border: 1px solid var(--border-focus);
    border-radius: var(--r-lg);
    padding: var(--s6);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: var(--s5);
    transform: scale(0.96) translateY(6px);
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-backdrop.is-open .modal-dialog {
    transform: scale(1) translateY(0);
  }

  .modal-close {
    position: absolute;
    top: var(--s4);
    right: var(--s4);
    width: 32px;
    height: 32px;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--t2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 160ms var(--ease);
  }

  .modal-close:hover {
    color: var(--t1);
    border-color: var(--t3);
  }

  .modal-top {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .modal-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .modal-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .modal-name {
