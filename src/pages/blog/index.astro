---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/common/Icon.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const seoTitle = "Engineering Notes & Creative Development Blog | Zain Ali Developer (zainalidev)";
const seoDesc = "Technical deep dives on GSAP motion, Lenis smooth scrolling, Anime.js physics, Astro performance optimization, and Core Web Vitals by Zain Ali Mughal.";
---

<Layout title={seoTitle} description={seoDesc}>
  <section class="blog-page">
    <div class="container">
      <!-- Breadcrumb / Back Link -->
      <div class="blog-nav-bar" data-hero>
        <a href="/" class="back-link">
          <span>← Back to portfolio</span>
        </a>
      </div>

      <!-- Header -->
      <header class="blog-page-header" data-hero>
        <div class="blog-badge">
          <span>CREATIVE ENGINEERING NOTES</span>
        </div>
        <h1 class="blog-page-title">Articles &amp; Field Notes</h1>
        <p class="blog-page-desc">
          Insights on motion synchronization, WebGL experimentation, Core Web Vitals optimization, and modern frontend architecture.
        </p>
      </header>

      <hr class="rule" data-rule />

      <!-- Interactive Search & Topic Filter Widget -->
      <div class="search-widget-wrapper" data-hero>
        <div class="search-box-shell" id="search-bar-box">
          <div class="search-icon-slot" aria-hidden="true">
            <Icon name="search" size={16} />
          </div>

          <div class="search-input-stage">
            <input
              type="text"
              id="blog-search-input"
              class="search-hidden-input"
              placeholder=""
              autocomplete="off"
              spellcheck="false"
              aria-label="Search articles by title, description, or keyword"
            />

            <div class="search-visual-viewport" aria-hidden="true">
              <span class="search-ghost-placeholder" id="search-placeholder">Search articles, tags, GSAP, Astro...</span>
              <div class="search-chars-stream" id="search-chars-container"></div>
              <span class="search-gliding-caret" id="search-custom-cursor"></span>
            </div>
          </div>

          <button
            type="button"
            id="search-clear-btn"
            class="search-clear-action"
            aria-label="Clear search query"
            hidden
          >
            <Icon name="x" size={13} />
          </button>

          <span class="search-count-pill mono" id="search-count-badge">
            {sortedPosts.length} {sortedPosts.length === 1 ? 'article' : 'articles'}
          </span>
        </div>

        <!-- Filter Chips Bar -->
        <div class="filter-chips-row" role="tablist" aria-label="Filter articles by topic">
          <span class="filter-caption mono">FILTER:</span>
          <button type="button" class="filter-chip is-active" data-filter="all">All</button>
          <button type="button" class="filter-chip" data-filter="gsap">GSAP</button>
          <button type="button" class="filter-chip" data-filter="astro">Astro</button>
          <button type="button" class="filter-chip" data-filter="performance">Performance</button>
          <button type="button" class="filter-chip" data-filter="lenis">Lenis</button>
          <button type="button" class="filter-chip" data-filter="motion">Motion</button>
          <button type="button" class="filter-chip" data-filter="architecture">Architecture</button>
        </div>
      </div>

      <!-- Post Listing -->
      <ul class="posts-grid" id="posts-grid">
        {sortedPosts.map((post) => (
          <li
            class="post-card-wrap"
            data-reveal
            data-tags={post.data.tags.map((t) => t.toLowerCase()).join(' ')}
            data-title={post.data.title.toLowerCase()}
            data-desc={post.data.description.toLowerCase()}
            data-status={post.data.status.toLowerCase()}
          >
            <a href={`/blog/${post.id}`} class="post-card">
              <div class="post-card-top">
                <span class="post-tag">{post.data.status}</span>
                <span class="mono post-read-time">{post.data.readTime}</span>
              </div>

              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>

              <div class="post-card-footer">
                <div class="post-chips">
                  {post.data.tags.map((tag) => (
                    <span class="chip-sm">{tag}</span>
                  ))}
                </div>
                <span class="post-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <!-- Empty Results State with Animated Bot Mascot -->
      <div id="blog-empty-state" class="blog-empty-state" hidden>
        <div class="empty-bot-mascot" aria-hidden="true">
          <div class="bot-floating-container">
            <svg class="bot-svg" viewBox="0 0 120 120" width="84" height="84">
              <defs>
                <radialGradient id="botHeadGlow" cx="50%" cy="30%" r="70%">
                  <stop offset="0%" stop-color="#2a2e38" />
                  <stop offset="100%" stop-color="#12141a" />
                </radialGradient>
                <linearGradient id="botVisorGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#0a0c12" />
                  <stop offset="100%" stop-color="#050608" />
                </linearGradient>
                <filter id="eyeGlow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="2.5" result="glow" />
                  <feMerge>
                    <feMergeNode in="glow" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>

              <g id="bot-head-group" class="bot-head-group">
                <!-- Antenna stalk & beacon light -->
                <line x1="60" y1="22" x2="60" y2="11" stroke="rgba(255,255,255,0.25)" stroke-width="2.5" stroke-linecap="round" />
                <circle id="bot-antenna" cx="60" cy="9" r="4" fill="var(--accent)" filter="url(#eyeGlow)" />

                <!-- Side ear muff pods -->
                <rect x="22" y="47" width="6" height="18" rx="3" fill="#1e222b" stroke="var(--border)" stroke-width="1.2" />
                <rect x="92" y="47" width="6" height="18" rx="3" fill="#1e222b" stroke="var(--border)" stroke-width="1.2" />

                <!-- Circular Head Body -->
                <circle cx="60" cy="56" r="34" fill="url(#botHeadGlow)" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />

                <!-- Dark Visor Screen -->
                <rect class="bot-visor-screen" x="35" y="42" width="50" height="26" rx="9" fill="url(#botVisorGrad)" stroke="rgba(110, 168, 254, 0.3)" stroke-width="1.2" />

                <!-- Animated Eyes Group -->
                <g id="bot-eyes" class="bot-eyes">
                  <ellipse class="bot-pupil" cx="50" cy="55" rx="4.5" ry="5.5" fill="var(--accent)" filter="url(#eyeGlow)" />
                  <ellipse class="bot-pupil" cx="70" cy="55" rx="4.5" ry="5.5" fill="var(--accent)" filter="url(#eyeGlow)" />
                  <circle cx="51.5" cy="53" r="1.5" fill="#ffffff" />
                  <circle cx="71.5" cy="53" r="1.5" fill="#ffffff" />
                </g>

                <!-- Dynamic Expressive Mouth -->
                <path id="bot-mouth" d="M 53 62 Q 60 62 67 62" stroke="rgba(110, 168, 254, 0.55)" stroke-width="1.6" stroke-linecap="round" fill="none" />
              </g>
            </svg>
          </div>
        </div>

        <h3 class="empty-title">No matching articles found</h3>
        <p class="empty-desc" id="empty-desc">
          Try adjusting your search terms or selecting another topic filter.
        </p>
        <button type="button" id="reset-filters-btn" class="reset-filters-btn">
          Reset Search &amp; Filters
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  import gsap from 'gsap';

  function initBlogSearchAndFilters() {
    const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const placeholder = document.getElementById('search-placeholder');
    const charsContainer = document.getElementById('search-chars-container');
    const customCursor = document.getElementById('search-custom-cursor');
    const clearBtn = document.getElementById('search-clear-btn');
    const countBadge = document.getElementById('search-count-badge');
    const searchBarBox = document.getElementById('search-bar-box');
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const postCards = document.querySelectorAll<HTMLElement>('.post-card-wrap');
    const emptyState = document.getElementById('blog-empty-state');
    const emptyDesc = document.getElementById('empty-desc');
    const resetBtn = document.getElementById('reset-filters-btn');

    // Bot mascot elements
    const botHead = document.getElementById('bot-head-group');
    const botEyes = document.getElementById('bot-eyes');
    const botMouth = document.getElementById('bot-mouth');
    const botAntenna = document.getElementById('bot-antenna');

    if (!input || !charsContainer || !customCursor || !placeholder) return;

    let activeFilter = 'all';
    let isTypingTimeout: number | undefined;

    // Launch continuous Mascot animation loop
    if (botHead && botEyes && botMouth && botAntenna) {
      // Gentle floating head
      gsap.to(botHead, {
        y: -4,
        duration: 1.8,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });

      // Antenna beacon pulse
      gsap.to(botAntenna, {
        opacity: 0.35,
        scale: 0.85,
        transformOrigin: 'center center',
        duration: 0.8,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });

      // Continuous search-and-shrug eye timeline
      const botTl = gsap.timeline({ repeat: -1, repeatDelay: 0.3 });
      botTl
        // Center gaze
        .to(botEyes, { x: 0, y: 0, duration: 0.5, ease: 'power2.out' })
        // Look smoothly left
        .to(botEyes, { x: -7, y: -1, duration: 0.5, ease: 'power2.inOut' }, '+=0.25')
        .to(botHead, { rotation: -3, transformOrigin: 'center 56px', duration: 0.5, ease: 'power2.inOut' }, '<')
        // Blink left
        .to(botEyes, { scaleY: 0.1, transformOrigin: 'center 55px', duration: 0.1, ease: 'power1.in' }, '+=0.35')
        .to(botEyes, { scaleY: 1, duration: 0.1, ease: 'power1.out' })
        // Look smoothly right
        .to(botEyes, { x: 7, y: -1, duration: 0.65, ease: 'power2.inOut' }, '+=0.3')
        .to(botHead, { rotation: 3, transformOrigin: 'center 56px', duration: 0.65, ease: 'power2.inOut' }, '<')
        // Blink right
        .to(botEyes, { scaleY: 0.1, transformOrigin: 'center 55px', duration: 0.1, ease: 'power1.in' }, '+=0.35')
        .to(botEyes, { scaleY: 1, duration: 0.1, ease: 'power1.out' })
        // Center & look down perplexed ("found nothing")
        .to(botEyes, { x: 0, y: 3.5, duration: 0.4, ease: 'power2.out' }, '+=0.25')
        .to(botHead, { rotation: 0, duration: 0.4, ease: 'power2.out' }, '<')
        // Mouth curves to confused shrug
        .to(botMouth, { attr: { d: 'M 54 64 Q 60 60 66 64' }, duration: 0.3, ease: 'power2.out' }, '<')
        // Bewildered blink
        .to(botEyes, { scaleY: 0.1, transformOrigin: 'center 58px', duration: 0.1 }, '+=0.5')
        .to(botEyes, { scaleY: 1, duration: 0.1 })
        // Restore neutral expression
        .to(botMouth, { attr: { d: 'M 53 62 Q 60 62 67 62' }, duration: 0.3, ease: 'power2.out' }, '+=0.7')
        .to(botEyes, { y: 0, duration: 0.3, ease: 'power2.out' }, '<');
    }

    // Helper: update smooth custom cursor position
    function updateCursorPosition(immediate = false) {
      if (!input || !charsContainer || !customCursor) return;

      const cursorIndex = input.selectionStart ?? input.value.length;
      // Only measure active chars (excluding those currently blurring out)
      const spans = charsContainer.querySelectorAll<HTMLSpanElement>('.search-char:not(.char-blur-out)');
      const containerRect = charsContainer.getBoundingClientRect();
      let targetX = 0;

      if (cursorIndex > 0 && spans.length > 0) {
        const targetSpan = spans[Math.min(cursorIndex - 1, spans.length - 1)];
        if (targetSpan) {
          const spanRect = targetSpan.getBoundingClientRect();
          targetX = spanRect.right - containerRect.left;
        }
      }

      if (immediate) {
        gsap.set(customCursor, { x: targetX });
      } else {
        gsap.to(customCursor, {
          x: targetX,
          duration: 0.16,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      }
    }

    // Helper: render typed text with blur-in from bottom and blur-out to top
    function renderVisualText() {
      if (!input || !charsContainer || !placeholder || !clearBtn) return;
      const value = input.value;

      // Toggle placeholder visibility and layout presence
      if (value.length > 0) {
        placeholder.style.display = 'none';
        clearBtn.hidden = false;
      } else {
        placeholder.style.display = '';
        clearBtn.hidden = true;
      }

      // Existing active spans
      const existingSpans = Array.from(
        charsContainer.querySelectorAll<HTMLSpanElement>('.search-char:not(.char-blur-out)')
      );
      const oldLen = existingSpans.length;
      const newLen = value.length;

      if (newLen > oldLen) {
        // CHARACTERS ADDED: Blur in from the bottom
        for (let i = oldLen; i < newLen; i++) {
          const char = value[i];
          const span = document.createElement('span');
          span.className = 'search-char char-blur-in';
          span.textContent = char === ' ' ? '\u00A0' : char;
          const delay = (i - oldLen) * 0.02;
          span.style.animationDelay = `${delay}s`;
          charsContainer.appendChild(span);
        }
      } else if (newLen < oldLen) {
        // CHARACTERS DELETED: Blur out from center to top
        for (let i = oldLen - 1; i >= newLen; i--) {
          const spanToRemove = existingSpans[i];
          if (spanToRemove) {
            // Lock position so flow of remaining characters is unaffected
            const offsetLeft = spanToRemove.offsetLeft;
            spanToRemove.style.position = 'absolute';
            spanToRemove.style.left = `${offsetLeft}px`;
            spanToRemove.classList.remove('char-blur-in');
            spanToRemove.classList.add('char-blur-out');
            setTimeout(() => {
              spanToRemove.remove();
            }, 180);
          }
        }
      } else {
        // Synchronize content in case of character replacement
        for (let i = 0; i < newLen; i++) {
          if (existingSpans[i] && existingSpans[i].textContent !== value[i]) {
            existingSpans[i].textContent = value[i] === ' ' ? '\u00A0' : value[i];
          }
        }
      }

      // Cursor briefly solid while typing
      customCursor?.classList.add('is-typing');
      window.clearTimeout(isTypingTimeout);
      isTypingTimeout = window.setTimeout(() => {
        customCursor?.classList.remove('is-typing');
      }, 350);

      // Glide cursor smoothly to new position
      requestAnimationFrame(() => updateCursorPosition());
    }

    // Filter cards logic
    function applyFilter() {
      if (!input) return;
      const query = input.value.trim().toLowerCase();
      let visibleCount = 0;

      postCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const tags = card.getAttribute('data-tags') || '';
        const status = card.getAttribute('data-status') || '';

        const matchesTag =
          activeFilter === 'all' ||
          tags.includes(activeFilter) ||
          title.includes(activeFilter) ||
          status.includes(activeFilter);

        const matchesQuery =
          !query ||
          title.includes(query) ||
          desc.includes(query) ||
          tags.includes(query);

        if (matchesTag && matchesQuery) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update count badge
      if (countBadge) {
        countBadge.textContent = `${visibleCount} ${visibleCount === 1 ? 'article' : 'articles'}`;
      }

      // Empty state
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.hidden = false;
          if (emptyDesc) {
            emptyDesc.textContent = query
              ? `No articles match "${query}" with filter "${activeFilter.toUpperCase()}".`
              : `No articles found for the selected "${activeFilter.toUpperCase()}" filter.`;
          }
        } else {
          emptyState.hidden = true;
        }
      }
    }

    // Input event handlers
    input.addEventListener('input', () => {
      renderVisualText();
      applyFilter();
    });

    input.addEventListener('focus', () => {
      searchBarBox?.classList.add('is-focused');
      customCursor?.classList.add('is-focused');
      updateCursorPosition();
    });

    input.addEventListener('blur', () => {
      searchBarBox?.classList.remove('is-focused');
      customCursor?.classList.remove('is-focused');
    });

    // Track caret movements on arrow keys, clicks, and selections
    const handleCaretMove = () => {
      requestAnimationFrame(() => updateCursorPosition());
    };

    input.addEventListener('keyup', (e) => {
      if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) {
        handleCaretMove();
      }
    });
    input.addEventListener('click', handleCaretMove);
    input.addEventListener('select', handleCaretMove);

    // Clear button with blur-out to top
    clearBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      const existingSpans = Array.from(
        charsContainer.querySelectorAll<HTMLSpanElement>('.search-char:not(.char-blur-out)')
      );
      existingSpans.forEach((span, idx) => {
        const offsetLeft = span.offsetLeft;
        span.style.position = 'absolute';
        span.style.left = `${offsetLeft}px`;
        span.classList.remove('char-blur-in');
        span.classList.add('char-blur-out');
        span.style.animationDelay = `${idx * 0.015}s`;
        setTimeout(() => span.remove(), 180 + idx * 15);
      });
      if (placeholder) placeholder.style.display = '';
      clearBtn.hidden = true;
      gsap.to(customCursor, { x: 0, duration: 0.18, ease: 'power2.out' });
      applyFilter();
      input.focus();
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      activeFilter = 'all';
      filterPills.forEach((p) => p.classList.toggle('is-active', p.dataset.filter === 'all'));
      charsContainer.innerHTML = '';
      if (placeholder) placeholder.style.display = '';
      if (clearBtn) clearBtn.hidden = true;
      gsap.to(customCursor, { x: 0, duration: 0.18, ease: 'power2.out' });
      applyFilter();
      input.focus();
    });

    // Filter pill buttons
    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        activeFilter = (pill.dataset.filter || 'all').toLowerCase();
        applyFilter();
      });
    });

    // Initial render
    renderVisualText();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogSearchAndFilters);
  } else {
    initBlogSearchAndFilters();
  }
</script>

<style>
  .blog-page {
    padding: var(--s12) 0 var(--s20);
    min-height: 80vh;
  }

  .blog-nav-bar {
    margin-bottom: var(--s8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    font-weight: 500;
    color: var(--t2);
    text-decoration: none;
    transition: color 160ms var(--ease), transform 160ms var(--ease);
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-2px);
  }

  .blog-page-header {
    margin-bottom: var(--s8);
  }

  .blog-badge {
    display: inline-flex;
    margin-bottom: var(--s3);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .blog-page-title {
    font-size: clamp(28px, 4.5vw, 38px);
    font-weight: 700;
    color: var(--t1);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .blog-page-desc {
    margin-top: var(--s3);
    font-size: 15px;
    line-height: 1.65;
    color: var(--t2);
    max-width: 60ch;
  }

  /* ==========================================================================
     SEARCH & FILTER WIDGET (Crisp Decreased Border Radius: var(--r-sm) = 6px)
     ========================================================================== */
  .search-widget-wrapper {
    margin: var(--s6) 0 var(--s8);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .search-box-shell {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: 48px;
    padding: 0 var(--s4);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-sm); /* Decreased crisp border-radius: 6px */
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: border-color 200ms var(--ease), box-shadow 200ms var(--ease), background-color 200ms var(--ease);
  }

  .search-box-shell:hover {
    border-color: var(--border-focus);
  }

  .search-box-shell.is-focused {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 0 20px var(--accent-glow);
    background: var(--card-hover);
  }

  .search-icon-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--t3);
    margin-right: var(--s3);
    flex-shrink: 0;
    transition: color 180ms var(--ease);
  }

  .search-box-shell.is-focused .search-icon-slot {
    color: var(--accent);
  }

  .search-input-stage {
    position: relative;
    flex: 1;
    height: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Real input capturing keyboard events starting at left: 0 */
  .search-hidden-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 10;
    cursor: text;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 14px;
    color: transparent;
    caret-color: transparent;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  /* Visual typography viewport aligned to the left edge */
  .search-visual-viewport {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
    z-index: 5;
    overflow: hidden;
  }

  /* Ghost placeholder positioned absolute to left edge */
  .search-ghost-placeholder {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    color: var(--t3);
    pointer-events: none;
    white-space: nowrap;
    user-select: none;
  }

  /* Stream of typed characters starts directly at left: 0 */
  .search-chars-stream {
    display: inline-flex;
    align-items: center;
    white-space: pre;
    position: relative;
    left: 0;
  }

  .search-char {
    display: inline-block;
    font-size: 14px;
    font-weight: 500;
    color: var(--t1);
    line-height: 1;
    transform-origin: center center;
    will-change: transform, opacity, filter;
  }

  /* Blur In from the Bottom Animation */
  .search-char.char-blur-in {
    animation: charBlurInFromBottom 200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes charBlurInFromBottom {
    0% {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(10px) scale(0.9);
    }
    60% {
      opacity: 0.85;
      filter: blur(2px);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
      transform: translateY(0) scale(1);
    }
  }

