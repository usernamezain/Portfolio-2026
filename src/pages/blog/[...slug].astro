---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/common/Icon.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = `https://zainalidev.com/blog/${post.id}`;
const articleTitle = `${post.data.title} | Zain Ali Developer`;

// Article Structured Data Schema for Google Search
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://zainalidev.com/#person"
  },
  "publisher": {
    "@type": "Person",
    "name": "Zain Ali Mughal",
    "url": "https://zainalidev.com"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  },
  "keywords": post.data.tags.join(', ')
};
---

<Layout
  title={articleTitle}
  description={post.data.description}
  canonicalUrl={postUrl}
>
  <!-- Article JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="article-page" itemscope itemtype="https://schema.org/TechArticle">
    <div class="container article-container">
      <!-- Breadcrumb Bar -->
      <nav class="article-nav" aria-label="Breadcrumb">
        <a href="/blog" class="back-link">
          <span>← Back to all articles</span>
        </a>
      </nav>

      <!-- Article Header -->
      <header class="article-header" data-hero>
        <div class="article-meta-top">
          <span class="post-tag">{post.data.status}</span>
          <span class="mono article-read-time">{post.data.readTime}</span>
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        
        <p class="article-lead">{post.data.description}</p>

        <div class="article-author-bar">
          <div class="author-info">
            <span class="author-name">By {post.data.author}</span>
            <span class="meta-dot" aria-hidden="true">•</span>
            <time datetime={post.data.pubDate.toISOString()} class="mono article-date">
              {formattedDate}
            </time>
          </div>

          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="chip-sm">{tag}</span>
            ))}
          </div>
        </div>
      </header>

      <hr class="rule" data-rule />

      <!-- Rendered Markdown Body -->
      <div class="article-body prose-content" data-reveal>
        <Content />
      </div>

      <hr class="rule" data-rule style="margin-top: var(--s16);" />

      <!-- Footer CTA / Back Link -->
      <footer class="article-footer" data-reveal>
        <div class="footer-cta-card">
          <h3>Need creative engineering on your project?</h3>
          <p>
            I specialize in ultra-fast Astro websites, GSAP animations, Anime.js interactive physics, and Three.js 3D experiences.
          </p>
          <div class="footer-actions">
            <a href="/#contact" class="btn btn-primary">
              <span>Get in touch</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
            <a href="/blog" class="btn">
              <span>More articles</span>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .article-page {
    padding: var(--s12) 0 var(--s20);
    min-height: 85vh;
  }

  .article-container {
    max-width: 720px;
  }

  .article-nav {
    margin-bottom: var(--s8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    font-weight: 500;
    color: var(--t2);
    text-decoration: none;
    transition: color 160ms var(--ease), transform 160ms var(--ease);
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-2px);
  }

  .article-header {
    margin-bottom: var(--s8);
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s4);
  }

  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    border: 1px solid var(--badge-border);
    border-radius: var(--r-sm);
    padding: 2px var(--s2);
    background: var(--badge-bg);
  }

  .article-read-time {
    font-size: 12px;
  }

  .article-title {
    font-size: clamp(26px, 4.5vw, 36px);
    font-weight: 700;
    color: var(--t1);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: var(--s4);
  }

  .article-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--t2);
    margin-bottom: var(--s6);
  }

  .article-author-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s3);
    padding-top: var(--s3);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    color: var(--t2);
  }

  .author-name {
    color: var(--t1);
    font-weight: 500;
  }

  .meta-dot {
    color: var(--t3);
  }

  .article-date {
    font-size: 12px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .chip-sm {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--t3);
    padding: 2px var(--s2);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
  }

  /* Prose Markdown Typography Styling */
  .prose-content {
    font-size: 15px;
    line-height: 1.75;
    color: var(--t2);
  }

  .prose-content :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--t1);
    margin: var(--s10) 0 var(--s4);
    letter-spacing: -0.015em;
  }

  .prose-content :global(h3) {
    font-size: 17px;
    font-weight: 600;
    color: var(--t1);
    margin: var(--s8) 0 var(--s3);
    letter-spacing: -0.01em;
  }

  .prose-content :global(p) {
    margin-bottom: var(--s5);
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin: var(--s4) 0 var(--s6) var(--s6);
    list-style: disc;
  }

  .prose-content :global(ol) {
    list-style: decimal;
  }

  .prose-content :global(li) {
    margin-bottom: var(--s2);
    padding-left: var(--s1);
  }

  .prose-content :global(strong) {
    color: var(--t1);
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose-content :global(hr) {
    border: 0;
    height: 1px;
    background: var(--divider);
    margin: var(--s10) 0;
  }

  .prose-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--s4);
    margin: var(--s6) 0;
    color: var(--t2);
    font-style: italic;
  }

  .prose-content :global(pre) {
    padding: var(--s4) var(--s5);
    background: #0d0d0e !important;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    margin: var(--s6) 0 var(--s8);
  }

  .prose-content :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: rgba(110, 168, 254, 0.08);
    color: var(--badge-text);
    padding: 2px 6px;
    border-radius: var(--r-sm);
    border: 1px solid var(--badge-border);
  }

  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--s6) 0 var(--s8);
    font-size: 13.5px;
  }

  .prose-content :global(th),
  .prose-content :global(td) {
    padding: var(--s3) var(--s4);
    border: 1px solid var(--border);
    text-align: left;
  }

  .prose-content :global(th) {
    background: var(--card);
    color: var(--t1);
    font-weight: 600;
  }

  .footer-cta-card {
    padding: var(--s8);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .footer-cta-card h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--t1);
    margin-bottom: var(--s2);
  }

  .footer-cta-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--t2);
    max-width: 54ch;
    margin-bottom: var(--s5);
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
</style>

