---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/common/Icon.astro';
import VibeCodingPoster from '../../components/media/VibeCodingPoster.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = `https://zainalidev.com/blog/${post.id}/`;
const articleTitle = `${post.data.title} | Zain Ali Developer (zainalidev)`;

// Comprehensive Rich Schema Graph (TechArticle + BreadcrumbList + FAQPage for #1 Search Snippets)
const articleSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "@id": `${postUrl}#article`,
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.pubDate.toISOString(),
      "dateModified": post.data.pubDate.toISOString(),
      "inLanguage": "en-US",
      "author": {
        "@type": "Person",
        "@id": "https://zainalidev.com/#person",
        "name": post.data.author,
        "url": "https://zainalidev.com"
      },
      "publisher": {
        "@type": "Person",
        "@id": "https://zainalidev.com/#person",
        "name": "Zain Ali Mughal",
        "url": "https://zainalidev.com"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": postUrl
      },
      "keywords": post.data.tags.join(', '),
      "articleSection": "Software Engineering & AI Architecture",
      "isAccessibleForFree": true,
      "image": "https://zainalidev.com/og-image.png"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${postUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://zainalidev.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://zainalidev.com/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": post.data.title,
          "item": postUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${postUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Vibe Coding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vibe Coding is an engineering paradigm where the human developer operates at the level of intent, architecture, and taste, while frontier language models (Claude, ChatGPT, Gemini) execute low-level code generation, refactoring, and boilerplate wiring in continuous flow state."
          }
        },
        {
          "@type": "Question",
          "name": "Who created the term Vibe Coding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The phrase 'vibe coding' was coined in early 2025 by renowned AI researcher and former Tesla AI Director Andrej Karpathy to describe coding with natural language prompts and embracing rapid AI code generation."
          }
        },
        {
          "@type": "Question",
          "name": "Is Vibe Coding just sloppy coding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Professional vibe coding demands higher architectural rigor than traditional coding: strict TypeScript types, atomic test loops, performance budgets (100/100 Core Web Vitals), and relentless visual polish."
          }
        },
        {
          "@type": "Question",
          "name": "What are the core rules of production Vibe Coding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Prompt with intent and constraints, not boilerplate. 2. Work in small atomic loops. 3. Keep strict TypeScript types and test runners active. 4. Own the architecture and never let AI dictate database schemas without verification."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={articleTitle}
  description={post.data.description}
  canonicalUrl={postUrl}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.pubDate.toISOString()}
  articleTags={post.data.tags}
  articleSection="Software Engineering & AI Architecture"
  structuredData={articleSchemaGraph}
>

  <article class="article-page" itemscope itemtype="https://schema.org/TechArticle">
    <div class="container article-container">
      <!-- Breadcrumb Bar -->
      <nav class="article-nav" aria-label="Breadcrumb">
        <a href="/blog" class="back-link">
          <span>← Back to all articles</span>
        </a>
      </nav>

      <!-- Article Header -->
      <header class="article-header" data-hero>
        <!-- Animated Pixel Video Poster (Orange Vibe Coding Studio with AI Bots) -->
        <VibeCodingPoster />

        <div class="article-meta-top">
          <span class="post-tag">{post.data.status}</span>
          <span class="mono article-read-time">{post.data.readTime}</span>
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        
        <p class="article-lead">{post.data.description}</p>

        <div class="article-author-bar">
          <div class="author-info">
            <span class="author-name">By {post.data.author}</span>
            <span class="meta-dot" aria-hidden="true">•</span>
            <time datetime={post.data.pubDate.toISOString()} class="mono article-date">
              {formattedDate}
            </time>
          </div>

          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="chip-sm">{tag}</span>
            ))}
          </div>
        </div>
      </header>

      <hr class="rule" data-rule />

      <!-- Rendered Markdown Body -->
      <div class="article-body prose-content" data-reveal>
        <Content />
      </div>

      <hr class="rule" data-rule style="margin-top: var(--s16);" />

      <!-- Footer CTA / Back Link -->
      <footer class="article-footer" data-reveal>
        <div class="footer-cta-card">
          <h3>Need creative engineering on your project?</h3>
          <p>
            I specialize in ultra-fast Astro websites, GSAP animations, Anime.js interactive physics, and Three.js 3D experiences.
          </p>
          <div class="footer-actions">
            <a href="/#contact" class="btn btn-primary">
              <span>Get in touch</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
            <a href="/blog" class="btn">
              <span>More articles</span>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .article-page {
    padding: var(--s12) 0 var(--s20);
    min-height: 85vh;
  }

  .article-container {
    max-width: 720px;
  }

  .article-nav {
    margin-bottom: var(--s8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    font-weight: 500;
    color: var(--t2);
    text-decoration: none;
    transition: color 160ms var(--ease), transform 160ms var(--ease);
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-2px);
  }

  .article-header {
    margin-bottom: var(--s8);
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s4);
  }

  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    border: 1px solid var(--badge-border);
    border-radius: var(--r-sm);
    padding: 2px var(--s2);
    background: var(--badge-bg);
  }

  .article-read-time {
    font-size: 12px;
  }

  .article-title {
    font-size: clamp(26px, 4.5vw, 36px);
    font-weight: 700;
    color: var(--t1);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: var(--s4);
  }

  .article-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--t2);
    margin-bottom: var(--s6);
  }

  .article-author-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s3);
    padding-top: var(--s3);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    color: var(--t2);
  }

  .author-name {
    color: var(--t1);
    font-weight: 500;
  }

  .meta-dot {
    color: var(--t3);
  }

  .article-date {
    font-size: 12px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .chip-sm {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--t3);
    padding: 2px var(--s2);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
  }

  /* Prose Markdown Typography Styling */
  .prose-content {
    font-size: 15px;
    line-height: 1.75;
    color: var(--t2);
  }

  .prose-content :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--t1);
    margin: var(--s10) 0 var(--s4);
    letter-spacing: -0.015em;
  }

  .prose-content :global(h3) {
    font-size: 17px;
    font-weight: 600;
    color: var(--t1);
    margin: var(--s8) 0 var(--s3);
    letter-spacing: -0.01em;
  }

  .prose-content :global(p) {
    margin-bottom: var(--s5);
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin: var(--s4) 0 var(--s6) var(--s6);
    list-style: disc;
  }

  .prose-content :global(ol) {
    list-style: decimal;
  }

  .prose-content :global(li) {
    margin-bottom: var(--s2);
    padding-left: var(--s1);
  }

  .prose-content :global(strong) {
    color: var(--t1);
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose-content :global(hr) {
    border: 0;
    height: 1px;
    background: var(--divider);
    margin: var(--s10) 0;
  }

  .prose-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--s4);
    margin: var(--s6) 0;
    color: var(--t2);
    font-style: italic;
  }

  .prose-content :global(pre) {
    padding: var(--s4) var(--s5);
    background: #0d0d0e !important;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    margin: var(--s6) 0 var(--s8);
  }

  .prose-content :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: rgba(110, 168, 254, 0.08);
    color: var(--badge-text);
    padding: 2px 6px;
    border-radius: var(--r-sm);
    border: 1px solid var(--badge-border);
  }

  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--s6) 0 var(--s8);
    font-size: 13.5px;
  }

  .prose-content :global(th),
  .prose-content :global(td) {
    padding: var(--s3) var(--s4);
    border: 1px solid var(--border);
    text-align: left;
  }

  .prose-content :global(th) {
    background: var(--card);
    color: var(--t1);
    font-weight: 600;
  }

  /* Interactive Diagrams & Flow Step Visuals */
  .prose-content :global(.vibe-flow-diagram) {
    margin: var(--s6) 0 var(--s8);
    padding: var(--s5);
    background: rgba(255, 106, 0, 0.04);
    border: 1px solid rgba(255, 106, 0, 0.2);
    border-radius: var(--r-md);
    overflow-x: auto;
  }

  .prose-content :global(.flow-steps) {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-width: 580px;
  }

  .prose-content :global(.flow-step) {
    flex: 1;
    padding: var(--s3) var(--s2);
    font-size: 11.5px;
    font-weight: 600;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    color: var(--t1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
  }

  .prose-content :global(.flow-arrow) {
    color: #ff9f0a;
    font-weight: bold;
    font-size: 14px;
    flex-shrink: 0;
  }

  /* Key Callout Alert Cards */
  .prose-content :global(.callout) {
    margin: var(--s8) 0;
    padding: var(--s5) var(--s6);
    border-radius: var(--r-md);
    background: rgba(255, 106, 0, 0.05);
    border: 1px solid rgba(255, 106, 0, 0.25);
    border-left: 4px solid #ff6a00;
  }

  .prose-content :global(.callout-header) {
    display: flex;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s3);
  }

  .prose-content :global(.callout-badge) {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    border-radius: 4px;
    background: #ff6a00;
    color: #fff;
    text-transform: uppercase;
  }

  .prose-content :global(.callout-title) {
    font-size: 14px;
    font-weight: 600;
    color: var(--t1);
  }

  .prose-content :global(.callout-body) {
    margin-bottom: 0 !important;
    font-size: 14.5px;
    color: var(--t1);
    line-height: 1.65;
  }

  /* Flow Comparison Pipelines */
  .prose-content :global(.flow-compare-grid) {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    margin: var(--s6) 0 var(--s8);
  }

  .prose-content :global(.compare-card) {
    padding: var(--s4) var(--s5);
    border-radius: var(--r-md);
    background: var(--card);
    border: 1px solid var(--border);
  }

  .prose-content :global(.compare-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s3);
    font-size: 12px;
  }

  .prose-content :global(.compare-badge) {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .prose-content :global(.badge-dim) {
    background: rgba(255, 255, 255, 0.06);
    color: var(--t2);
    border: 1px solid var(--border);
  }

  .prose-content :global(.badge-accent) {
    background: rgba(255, 106, 0, 0.15);
    color: #ff9f0a;
    border: 1px solid rgba(255, 106, 0, 0.3);
  }

  .prose-content :global(.compare-friction) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--t3);
  }

  .prose-content :global(.friction-fast) {
    color: #10b981;
    font-weight: 600;
  }

  .prose-content :global(.compare-pipeline) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .prose-content :global(.pipeline-pill) {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    color: var(--t2);
  }

  .prose-content :global(.pill-accent) {
    background: rgba(255, 106, 0, 0.1);
    border-color: rgba(255, 106, 0, 0.25);
    color: var(--t1);
    font-weight: 600;
  }

  .prose-content :global(.pipeline-arrow) {
    color: var(--t3);
    font-size: 11px;
  }

  .prose-content :global(.arrow-accent) {
    color: #ff9f0a;
    font-weight: bold;
  }

  .footer-cta-card {
    padding: var(--s8);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .footer-cta-card h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--t1);
    margin-bottom: var(--s2);
  }

  .footer-cta-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--t2);
    max-width: 54ch;
    margin-bottom: var(--s5);
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
</style>

