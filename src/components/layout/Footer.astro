---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container footer-container">
    <div class="footer-left">
      <span class="mono">© {currentYear} Zain Ali Mughal (zainalidev). All rights reserved.</span>
    </div>
    
    <div class="footer-right">
      <a href="#top" class="back-to-top" aria-label="Back to top of the page">
        <span>Back to top ↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--s8) 0;
    border-top: 1px solid var(--divider);
    background: var(--bg);
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--t3);
  }

  .back-to-top {
    color: var(--t2);
    font-weight: 500;
    transition: color 160ms var(--ease);
  }

  .back-to-top:hover {
    color: var(--t1);
  }

  @media (max-width: 600px) {
    .footer-container {
      flex-direction: column;
      gap: var(--s3);
      text-align: center;
    }
  }
</style>
