---
import { getCollection } from 'astro:content';
import Icon from '../common/Icon.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<section id="blog" aria-label="Technical Writing and Insights">
  <div class="container">
    <hr class="rule" data-rule />
    <div class="blog-section-header" data-reveal>
      <h2>Engineering Notes &amp; Blog</h2>
      <a href="/blog" class="all-posts-link">
        <span>View all articles</span>
        <Icon name="arrow-up-right" size={15} />
      </a>
    </div>
    
    <p class="blog-intro" data-reveal>
      Deep dives on AI-first software engineering, vibe coding architectures, and modern full-stack systems.
    </p>

    <ul class="blog-list">
      {sortedPosts.map((post) => (
        <li class="blog-item" data-reveal>
          <a href={`/blog/${post.id}/`} class="blog-row-link">
            <div class="blog-header">
              <h3 class="blog-row-title">{post.data.title}</h3>
              <span class="post-tag">{post.data.status}</span>
            </div>
            <p class="blog-body">{post.data.description}</p>
            <div class="blog-footer">
              <span class="mono read-time">{post.data.readTime}</span>
              <span class="read-article-btn">
                <span>Read article</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .blog-section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s4);
    margin-bottom: var(--s2);
  }

  .all-posts-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 160ms var(--ease);
  }

  .all-posts-link:hover {
    opacity: 0.8;
  }

  .blog-intro {
    max-width: 62ch;
    font-size: 13.5px;
    color: var(--t2);
    margin: 0 0 var(--s6);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
  }

  .blog-item {
    width: 100%;
    border-bottom: 1px solid var(--divider);
  }

  .blog-item:last-child {
    border-bottom: 0;
  }

  .blog-row-link {
    display: block;
    width: 100%;
    padding: var(--s5) 0;
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }

  .blog-row-link:hover .blog-row-title {
    color: var(--accent);
  }

  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s4);
    width: 100%;
  }

  .blog-row-title {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--t1);
    letter-spacing: -0.01em;
    transition: color 160ms var(--ease);
  }

  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 2px var(--s2);
    background: var(--card);
    flex-shrink: 0;
  }

  .blog-body {
    margin-top: var(--s2);
    font-size: 13px;
    line-height: 1.6;
    color: var(--t2);
    max-width: 64ch;
  }

  .blog-footer {
    margin-top: var(--s3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .read-time {
    font-size: 12px;
    color: var(--t3);
  }

  .read-article-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--t2);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    transition: background-color 160ms var(--ease), border-color 160ms var(--ease), color 160ms var(--ease), transform 160ms var(--ease), box-shadow 160ms var(--ease);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 160ms var(--ease);
  }

  .blog-row-link:hover .read-article-btn {
    background: var(--card-hover);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateX(2px);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.35), 0 0 10px var(--accent-glow);
  }

  .blog-row-link:hover .read-article-btn .btn-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    .blog-header {
      flex-direction: column;
      gap: var(--s1);
    }
    .blog-section-header {
      flex-direction: column;
      gap: var(--s2);
    }
  }
</style>
