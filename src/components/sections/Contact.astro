---
import Icon from '../common/Icon.astro';
import { portfolioData } from '../../data/portfolio';
---

<section id="contact" aria-label="Contact and Social Links">
  <div class="container">
    <hr class="rule" data-rule />
    <h2 data-reveal>Contact &amp; Connect</h2>
    
    <p class="contact-lede" data-reveal>
      Have a project in mind, need creative development assistance, or want to build a lightning-fast portfolio? Reach out directly via any of the platforms below:
    </p>

    <div class="social-links" data-reveal>
      <a class="contact-link" href={portfolioData.contact.github} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={17} />
        <span>GitHub</span>
      </a>

      <a class="contact-link" href={portfolioData.contact.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="linkedin" size={17} />
        <span>LinkedIn</span>
      </a>

      <a class="contact-link" href={portfolioData.contact.instagram} target="_blank" rel="noopener noreferrer">
        <Icon name="instagram" size={17} />
        <span>Instagram</span>
      </a>

      <a class="contact-link" href={portfolioData.contact.whatsappChannel} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={17} />
        <span>WhatsApp Channel</span>
      </a>
    </div>

    <div class="community-card" data-reveal>
      <h3>Mughal Dev Community</h3>
      <p>
        An open community for developers and designers where I share free animation templates, performance tips, and client project breakdowns.
      </p>
      <a class="community-btn" href={portfolioData.contact.whatsappChannel} target="_blank" rel="noopener noreferrer">
        <span>Join Mughal.Dev Community</span>
        <Icon name="arrow-up-right" size={15} />
      </a>
    </div>
  </div>
</section>

<style>
  .contact-lede {
    max-width: 64ch;
    font-size: 14px;
    line-height: 1.65;
    color: var(--t2);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    margin-top: var(--s6);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    color: var(--t1);
    font-size: 13.5px;
    font-weight: 500;
    transition: color 160ms var(--ease), transform 160ms var(--ease);
  }

  .contact-link:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .community-card {
    margin-top: var(--s12);
    padding: var(--s6);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .community-card h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--t1);
    margin-bottom: var(--s2);
  }

  .community-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--t2);
    max-width: 60ch;
    margin-bottom: var(--s4);
  }

  .community-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 160ms var(--ease);
  }

  .community-btn:hover {
    opacity: 0.8;
  }
</style>
