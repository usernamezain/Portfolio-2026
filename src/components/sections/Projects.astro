---
import Icon from '../common/Icon.astro';
import ProjectMedia from '../media/ProjectMedia.astro';
import { portfolioData } from '../../data/portfolio';

// Highlighted featured projects for the home page showcase (4 clean highlight projects)
const featuredProjects = portfolioData.projects.filter(p => p.highlight);
---

<section id="projects" aria-label="Selected Client Work and Projects">
  <div class="container">
    <hr class="rule" data-rule />
    <h2 data-reveal>Selected Work</h2>
    
    <ul class="projects-grid">
      {featuredProjects.map((project) => (
        <li data-reveal>
          <a
            class="project-card"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.title} - Visit Live Website`}
          >
            <!-- Media Optimized Visual Preview -->
            <ProjectMedia
              src={project.image}
              alt={`${project.title} - Preview Showcase by Zain Ali Developer`}
            />

            <div class="card-body">
              <div class="card-header">
                <h3 class="card-title">{project.title}</h3>
                <span class="card-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </div>
              
              <p class="card-desc">{project.description}</p>
              
              <div class="card-footer">
                <span class="mono card-tags">{project.tags.join(' • ')}</span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- Smooth action button centered over one clean gray line -->
    <div class="projects-more-row">
      <div class="divider-line" aria-hidden="true"></div>
      <a
        href="/projects"
        class="projects-more-btn border-beam border-beam--hover"
      >
        <span class="btn-text">More projects in categorized version</span>
        <span class="btn-arrow" aria-hidden="true">
          <Icon name="arrow-right" size={15} />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--s4);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: background-color 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease);
  }

  .project-card:hover {
    background: var(--card-hover);
    border-color: var(--t3);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.2);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
  }

  .card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--t1);
    letter-spacing: -0.01em;
  }

  .card-arrow {
    display: inline-flex;
    color: var(--t3);
    transition: color 160ms var(--ease);
  }

  .project-card:hover .card-arrow {
    color: var(--t1);
  }

  .card-desc {
    margin-top: var(--s2);
    font-size: 13px;
    line-height: 1.6;
    color: var(--t2);
    flex-grow: 1;
  }

  .card-footer {
    margin-top: var(--s4);
  }

  .card-tags {
    display: block;
    font-size: 11.5px;
    color: var(--t3);
  }

  /* ==========================================================================
     MORE PROJECTS BUTTON ROW (SMOOTH WITH ONE GRAY LINE - MATCHING TECH STACK)
     ========================================================================== */
  .projects-more-row {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: var(--s12);
    padding: var(--s4) 0;
  }

  .divider-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--border);
    z-index: 1;
  }

  .projects-more-btn {
    --beam-color: var(--accent);
    --beam-glow: 6px;
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: 10px var(--s5);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    color: var(--t1);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    outline: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: background-color 180ms var(--ease), border-color 180ms var(--ease), transform 180ms var(--ease), box-shadow 180ms var(--ease);
  }

  .projects-more-btn:focus,
  .projects-more-btn:focus-visible {
    outline: none;
  }

  :global(html[data-theme="light"]) .projects-more-btn {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .projects-more-btn:hover {
    background: var(--card-hover);
    border-color: var(--border);
    outline: none;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    color: var(--t1);
  }

  .btn-arrow {
    display: inline-flex;
    align-items: center;
    transition: transform 180ms var(--ease);
  }

  .projects-more-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 680px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
