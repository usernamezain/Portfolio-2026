---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide-icon ${className}`}
  aria-hidden="true"
  set:html={innerContent}
/>

<style>
  .lucide-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>

