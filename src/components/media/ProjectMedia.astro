---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
}

const { src, alt, class: className = '' } = Astro.props;
---

<div class={`project-media-container ${className}`}>
  {typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      width={600}
      height={340}
      loading="lazy"
      decoding="async"
      class="project-img"
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      width={600}
      height={340}
      loading="lazy"
      decoding="async"
      class="project-img"
    />
  )}
  <div class="media-overlay" aria-hidden="true"></div>
</div>

<style>
  .project-media-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-md, 8px);
    overflow: hidden;
    background: #141416;
    border: 1px solid var(--border);
    margin-bottom: var(--s4, 16px);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1);
  }

  :global(.project-card:hover) .project-img {
    transform: scale(1.04);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 60%, rgba(0, 0, 0, 0.4) 100%);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  :global(.project-card:hover) .media-overlay {
    opacity: 0.2;
  }
</style>
