---
import { Image } from 'astro:assets';
import avatarImg from '../../assets/images/avatar/avatar.svg';

interface Props {
  size?: number;
  class?: string;
}

const { size = 68, class: className = '' } = Astro.props;
---

<div class={`avatar-wrapper ${className}`} style={`--avatar-size: ${size}px;`}>
  <Image
    src={avatarImg}
    alt="Zain Ali Mughal (zainalidev) - Creative Developer"
    width={size}
    height={size}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="avatar-img"
  />
</div>

<style>
  .avatar-wrapper {
    position: relative;
    width: var(--avatar-size, 68px);
    height: var(--avatar-size, 68px);
    flex-shrink: 0;
    border-radius: var(--r-full, 9999px);
    padding: 2px;
    background: linear-gradient(135deg, rgba(110, 168, 254, 0.4), rgba(168, 85, 247, 0.2));
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    display: block;
    transition: transform 0.3s var(--ease, ease);
  }

  .avatar-wrapper:hover .avatar-img {
    transform: scale(1.05);
  }
</style>

