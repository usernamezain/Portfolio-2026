---
---

<div id="preloader" class="preloader" role="status" aria-live="polite" aria-label="Loading Zain Ali Developer Portfolio">
  <div class="preloader-content">
    <div class="preloader-brand">
      <span class="preloader-tag">[zainalidev]</span>
      <span class="preloader-dot"></span>
      <span class="preloader-status">INITIALIZING CORE</span>
    </div>

    <div class="preloader-center">
      <div class="preloader-initials">
        <span class="p-char">Z</span>
        <span class="p-char">A</span>
        <span class="p-char">I</span>
        <span class="p-char">N</span>
        <span class="p-space"></span>
        <span class="p-char">A</span>
        <span class="p-char">L</span>
        <span class="p-char">I</span>
      </div>
      <div class="preloader-counter" id="preloader-counter">00%</div>
    </div>

    <div class="preloader-track-wrap">
      <div class="preloader-track">
        <div class="preloader-bar" id="preloader-bar"></div>
      </div>
      <div class="preloader-meta">
        <span class="p-left">SPEED_INDEX: 1.0</span>
        <span class="p-right">CREATIVE_ENGINE: READY</span>
      </div>
    </div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    color: #f5f5f5;
    font-family: var(--font-mono, monospace);
    overflow: hidden;
    user-select: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .preloader.preloader-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .preloader-content {
    width: 90%;
    max-width: 440px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: rgba(20, 20, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(16px);
  }

  .preloader-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #888888;
  }

  .preloader-tag {
    color: #6ea8fe;
    font-weight: 600;
  }

  .preloader-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse 1.5s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .preloader-status {
    text-transform: uppercase;
  }

  .preloader-center {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .preloader-initials {
    display: flex;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    font-family: var(--font-sans, sans-serif);
  }

  .p-space {
    width: 8px;
  }

  .p-char {
    display: inline-block;
    opacity: 0.85;
  }

  .preloader-counter {
    font-size: 28px;
    font-weight: 600;
    color: #6ea8fe;
    font-variant-numeric: tabular-nums;
  }

  .preloader-track-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .preloader-track {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }

  .preloader-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #6ea8fe, #a855f7);
    border-radius: 9999px;
    transition: width 0.05s linear;
    box-shadow: 0 0 12px rgba(110, 168, 254, 0.8);
  }

  .preloader-meta {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: #666666;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader {
      display: none !important;
    }
  }
</style>
